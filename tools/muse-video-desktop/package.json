{
  "name": "muse-video-desktop-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Local desktop manager bridging CLIProxyAPI and Muse2API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "package:win": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ./build-worker.ps1 && electron-builder --win nsis",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/bridge.test.js"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "local.musevideomanager",
    "productName": "Muse Video Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "package.json",
      "node_modules/yaml/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Muse-Video-Manager-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "worker-dist/muse-worker",
        "to": "muse-worker",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
