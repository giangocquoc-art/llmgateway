{
  "name": "muse-video-desktop-bridge",
  "private": true,
  "version": "0.1.0",
  "description": "Local desktop manager bridging CLIProxyAPI and Muse2API",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/bridge.test.js"
  },
  "dependencies": { "yaml": "^2.6.1" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "45.1.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "local.musevideomanager",
    "productName": "Muse Video Manager",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "ui/**/*", "package.json", "node_modules/yaml/**/*"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
